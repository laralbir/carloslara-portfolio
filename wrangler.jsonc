{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "carloslara-portfolio",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "preview_urls": true,
  "previews": {},
  "assets": {
    "directory": "./dist"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  }
}
